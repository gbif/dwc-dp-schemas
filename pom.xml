<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.gbif</groupId>
    <artifactId>motherpom</artifactId>
    <version>61</version>
  </parent>

  <artifactId>dwc-dp-schemas</artifactId>
  <version>0.0.3</version>
  <packaging>jar</packaging>

  <name>dwc-dp-schemas</name>
  <description>DarwinCore datapackage schema definitions</description>
  <url>https://github.org/gbif/dwc-dp-schemas</url>

  <scm>
    <connection>scm:git:git@github.com:gbif/dwc-dp-schemas.git</connection>
    <url>https://github.com/gbif/dwc-dp-schemas</url>
    <developerConnection>scm:git:git@github.com:gbif/dwc-dp-schemas.git</developerConnection>
    <tag>dwc-dp-schemas-0.0.3</tag>
  </scm>

  <distributionManagement>
    <site>
      <id>gh-pages</id>
      <url>http://gbif.github.io/dwc-dp-schemas/</url>
    </site>
    <repository>
      <id>gbif-release</id>
      <url>https://repository.gbif.org/content/repositories/releases</url>
    </repository>
    <snapshotRepository>
      <id>gbif-deploy</id>
      <url>https://repository.gbif.org/content/repositories/snapshots</url>
    </snapshotRepository>
  </distributionManagement>

  <repositories>
    <repository>
      <id>gbif-all</id>
      <url>https://repository.gbif.org/content/groups/gbif</url>
    </repository>
    <repository>
      <id>thirdparty</id>
      <url>https://repository.gbif.org/content/repositories/thirdparty</url>
    </repository>
  </repositories>

  <build>
    <plugins>
      <!--
        Disable the default maven-jar-plugin's test-jar goal — this is a resource-only
        artifact and has no Java sources. The default jar goal still runs and packages
        src/main/resources into the jar.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-test-jar</id>
            <phase>none</phase>
          </execution>
        </executions>
        <configuration>
          <skipIfEmpty>false</skipIfEmpty>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
